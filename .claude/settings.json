{
  "permissions": {
    "deny": ["Skill(caveman:caveman-commit)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-writer-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-main-push.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "input=\"$(cat)\"; printf '%s' \"$input\" | \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prettier-edited.sh; printf '%s' \"$input\" | \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/eslint-edited.sh",
            "timeout": 60,
            "statusMessage": "Prettier + ESLint on edited file..."
          }
        ]
      }
    ]
  }
}
