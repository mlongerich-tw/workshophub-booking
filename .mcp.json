{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    },
    "jira": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "oauth": {
        "callbackPort": 58617
      }
    }
  }
}